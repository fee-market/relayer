{
  "name": "@feemarket/relayer",
  "version": "0.1.0",
  "private": true,
  "description": "Sponsor-side relayer for v1.fee.market \u2014 validates user delegations and broadcasts EIP-7702 (type-4) redemptions paying gas on the user's behalf.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -r src/public dist/public",
    "start": "node dist/index.js",
    "listing:gen": "tsx src/sponsor/generateListing.ts",
    "sponsor:register": "tsx src/sponsor/register.ts register",
    "sponsor:list": "tsx src/sponsor/register.ts list",
    "sponsor:status": "tsx src/sponsor/register.ts status",
    "sponsor:rotate": "tsx src/sponsor/rotate.ts",
    "sponsor:accept": "tsx src/sponsor/consent.ts",
    "test:metadata": "tsx tools/metadata.test.ts",
    "test:pinning": "tsx tools/pinning.test.ts",
    "sponsor:metadata:upload": "tsx src/sponsor/publishMetadata.ts upload",
    "sponsor:metadata:set": "tsx src/sponsor/publishMetadata.ts set",
    "sponsor:metadata:publish": "tsx src/sponsor/publishMetadata.ts publish",
    "e2e": "tsx tools/e2e.ts",
    "e2e:bootstrap": "tsx tools/bootstrapSubscribe.ts",
    "e2e:mainnet-transfer": "tsx tools/mainnetTransfer.ts",
    "e2e:subscribe": "tsx tools/subscribeViaEndpoint.ts",
    "e2e:topup": "tsx tools/topUpViaEndpoint.ts",
    "typecheck": "tsc --noEmit",
    "test:charge": "tsx tools/charge.test.ts",
    "sponsor:init": "tsx src/sponsor/init.ts",
    "sponsor:plans:configure": "tsx tools/configurePlans.ts",
    "sponsor:doctor": "tsx src/sponsor/doctor.ts",
    "test:doctor": "tsx tools/doctor.test.ts",
    "check:framework": "tsx tools/frameworkConformance.ts",
    "sponsor:onboard": "tsx src/sponsor/onboard.ts",
    "sponsor:go": "tsx src/sponsor/go.ts",
    "sponsor:withdraw": "tsx src/sponsor/withdraw.ts",
    "sponsor:endpoint": "tsx src/sponsor/endpoint.ts",
    "sponsor:relayers": "tsx src/sponsor/relayers.ts",
    "test:onboard": "tsx tools/onboard.test.ts",
    "test:hardening": "tsx tools/hardening.test.ts",
    "test:txmanager": "tsx tools/txmanager.test.ts",
    "test:validators": "tsx tools/validators.test.ts",
    "test:resilience": "tsx tools/resilience.test.ts",
    "test:abuse": "tsx tools/abuse.test.ts",
    "test:security": "tsx tools/security.test.ts",
    "test:metrics": "tsx tools/metrics.test.ts",
    "test:signer": "tsx tools/signer.test.ts",
    "test:profit": "tsx tools/profit.test.ts",
    "test:sponsorset": "tsx tools/sponsorset.test.ts",
    "test:walletparity": "tsx tools/walletparity.test.ts",
    "test:explorer": "tsx tools/explorer.test.ts",
    "test:alertsink": "tsx tools/alertsink.test.ts",
    "alerts:sink": "tsx tools/alertsink.ts",
    "canary": "tsx tools/canary.ts",
    "chaos": "tsx tools/chaos.ts",
    "key:encrypt": "tsx src/sponsor/keystore.ts encrypt",
    "key:check": "tsx src/sponsor/keystore.ts check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "thirdweb": "^5.122.0",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
