# ─── Chain ───────────────────────────────────────────────────────────────────
# Use a PAID provider as RPC_URL for production; free public endpoints are for testing.
RPC_URL=https://polygon-bor-rpc.publicnode.com
# Optional fallbacks, comma-separated. Reads fail over down the list; every transaction is sent to ALL providers.
RPC_URLS=
CHAIN_ID=137
CONFIRMATIONS=1

# ─── Sponsor relayer key (pays gas, submits type-4 txns). KEEP SECRET. ─────────
RELAYER_PRIVATE_KEY=0x...

# ─── Deployed addresses (MetaMask Delegation Framework on Polygon + our registry)
DELEGATION_MANAGER=0xdb9B1e94B5b69Df7e401DDbedE43491141047dB3
DELEGATOR_IMPLEMENTATION=0x63c0c19a282a1B52b07dD5a65b58948A07DAE32B
FEE_MARKET_REGISTRY=0x57e6742610229c7Ce09df3028471397DaaE6B9f4
REDEEMER_RESTRICTION_ENFORCER=0x5C75d7ee6d3d27634bec15e96538e794F9c7053b
# Locks a delegation to the SPONSOR's relayer set instead of one key (terms: registry + sponsorId). Accepted in place of the line above.
SPONSOR_RELAYER_ENFORCER=0x051F314E5312341B3F0e0da2024a56A0cD0cacBB
# MetaMask caveat enforcers every delegation must carry (defaults = Polygon)
LIMITED_CALLS_ENFORCER=0x04658B29F6b82ed55274221a06Fc97D318E25416
EXACT_EXECUTION_BATCH_ENFORCER=0x1e141e455d08721Dd5BCDA1BaA6Ea5633Afd5017
TIMESTAMP_ENFORCER=0x1046bb45C8d673d4ea75321280DB34899413c069

# ─── This sponsor ─────────────────────────────────────────────────────────────
SPONSOR_ID=1
SPONSOR_METADATA_URI=ipfs://<pin-your-metadata.json>
PUBLIC_RELAYER_URL=https://relay.example
# Name and region in your published profile. Only read when there is no sponsor.plans.json (`npm run sponsor:plans:configure`
# writes one, and it takes priority). Changing either changes your metadata, which sends a verified sponsor back to Pending.
# SPONSOR_NAME=My Gas Co
# SPONSOR_REGION=eu-west
# Optional profile shown to users in the wallet (https only; reviewed by the curator with the rest of your metadata).
SPONSOR_DESCRIPTION=
SPONSOR_WEBSITE=
SPONSOR_SUPPORT_URL=
# Where earnings are paid and who may withdraw / rotate keys. Use a separate cold wallet in production.
# `sponsor:register` falls back to the relayer address if this is empty.
SPONSOR_PAYOUT_ADDRESS=
# Domain pointing at this host; used by docker-compose.yml (Caddy gets the TLS certificate for it).
PUBLIC_DOMAIN=

# ─── Metadata storage (used by src/sponsor/metadata.ts / publishMetadata.ts) ──
# IPFS is the default (publicly fetchable, no storage keys needed by anyone reading it). Get either
# free at https://thirdweb.com/dashboard — THIRDWEB_SECRET_KEY is recommended for a server (no domain
# restriction); THIRDWEB_CLIENT_ID (a public id) also works, same one the web Sponsor panel uses.
THIRDWEB_SECRET_KEY=
THIRDWEB_CLIENT_ID=
# Set to "filone" to use an S3-compatible Fil One bucket instead (must be public-read: the web app has
# no special-cased Fil One fetch path, so a private bucket would not be reachable by clients).
METADATA_STORAGE=ipfs
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
FIL_BUCKET=
FIL_REGION=eu-west-1
# S3 endpoint for the bucket. Empty = https://<FIL_REGION>.s3.filonecontent.com
# FIL_ENDPOINT=

# ─── Sponsor dashboard (/admin) ───────────────────────────────────────────────
# Bearer token to view stats & logs. Leave empty to DISABLE the dashboard (fail-closed).
DASHBOARD_TOKEN=
# Token whose claimable earnings are shown on the dashboard (default USDC on Polygon).
DASHBOARD_EARNINGS_TOKEN=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# ─── State (survives restarts) ────────────────────────────────────────────────
# Transactions still in flight (so a stuck one is still replaced after a restart) and the dashboard history live here.
# Empty = not persisted. In Docker this is a volume (docker-compose.yml sets it to /app/data).
STATE_DIR=./data
# On SIGTERM: finish requests already running for up to this long (ms), then exit.
DRAIN_MS=20000

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8787
# Header with the REAL client IP when ALL traffic comes through an edge you control (Cloudflare tunnel:
# cf-connecting-ip). Without it, a tunnel makes every user share one per-IP rate-limit bucket. Empty = off.
CLIENT_IP_HEADER=
# Reverse-proxy hops in front of the node (docker-compose.yml sets 1). Keep 0 if exposed directly.
TRUST_PROXY=0
# Comma-separated allowed CORS origins, or * for any.
CORS_ORIGINS=*

# ─── Policy (protect the sponsor) ─────────────────────────────────────────────
# Refuse redemptions whose estimated gas cost (wei) exceeds this. 0 = no cap (not advised). Default 0.1 of the
# native token.
MAX_GAS_WEI=100000000000000000
# Hard ceiling on gas UNITS for one redemption; also set as the transaction's own gas limit, so a heavy user-built
# batch can never burn more than this.
MAX_GAS_UNITS=600000
# A sponsored batch is one charged operation however much it does: bound the number of calls (including the final
# charge) and the total calldata bytes.
MAX_BATCH_CALLS=8
MAX_BATCH_CALLDATA_BYTES=8192
# Optional: only these contracts may be called by the action part of a batch (comma-separated). Empty = any.
ALLOWED_TARGETS=
# Pause sponsored sends (HTTP 503, and /health goes unhealthy) while the relayer holds less than this many wei.
MIN_RELAYER_BALANCE_WEI=300000000000000000
# Do not broadcast while the network's max fee per gas is above this (gwei). 0 = off.
MAX_FEE_PER_GAS_GWEI=500
# A request waits this long for its receipt, then answers 504 "sent, not confirmed yet" (the wallet gives up at 20 s).
RECEIPT_WAIT_MS=18000
# A transaction with no receipt after this long is re-sent with a higher fee (same nonce), up to MAX_REPLACEMENTS times.
STUCK_AFTER_MS=20000
MAX_REPLACEMENTS=3
REPLACEMENT_BUMP_PERCENT=25
# Optional webhook (Slack, Discord or any JSON POST) told when the relayer runs low or a transaction gets stuck.
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MS=600000
# Require the user delegation to carry the RedeemerRestrictionEnforcer caveat.
REQUIRE_REDEEMER_RESTRICTION=true
# Longest delegation lifetime the relayer accepts (seconds)
MAX_DELEGATION_TTL_SECONDS=3600
# eth_call the redemption before broadcasting so reverts never cost gas.
SIMULATE_BEFORE_SEND=true
# Per-IP rate limit.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
# Per-account budget over the same window (0 = off): one user cannot burn your gas by sending from many IPs.
RATE_LIMIT_DELEGATOR_MAX=10
# Sponsored requests processed at once, and how many may wait behind them; beyond that the node answers 503 + Retry-After.
MAX_CONCURRENT_SPONSORED=8
MAX_QUEUED_SPONSORED=16
# A wallet retrying a request it already sent gets the original answer back for this long (ms), not a second send.
IDEMPOTENCY_TTL_MS=600000
# Plans and the gas price are reused this long (ms); subscriptions are never cached.
READ_CACHE_MS=15000

# --- Key management (see src/lib/signer.ts) ---
# Where the signing key comes from: env (RELAYER_PRIVATE_KEY above), keystore (encrypted file) or remote (signing service).
RELAYER_KEY_SOURCE=env
# keystore: create it with `RELAYER_PRIVATE_KEY=0x… npm run key:encrypt -- --out ./secrets/relayer.keystore.json --password-file ./secrets/relayer.pass`,
# then remove RELAYER_PRIVATE_KEY from this file.
RELAYER_KEYSTORE_FILE=
RELAYER_KEYSTORE_PASSWORD_FILE=
# remote: the node sends each transaction's digest to this URL and checks the signature recovers to RELAYER_SIGNER_ADDRESS.
RELAYER_SIGNER_URL=
RELAYER_SIGNER_TOKEN=
RELAYER_SIGNER_ADDRESS=

# --- Monitoring (see docs/runbooks) ---
# Interface to listen on. Behind a tunnel or reverse proxy on this machine use 127.0.0.1, so nothing else can reach the
# node directly (and nobody can forge CLIENT_IP_HEADER). 0.0.0.0 is for Docker.
HOST=0.0.0.0
# Bearer token for GET /metrics (Prometheus). Empty = /metrics is off. Use a long random value: `openssl rand -hex 32`.
METRICS_TOKEN=
# json (one object per line, for a log pipeline) or text; debug|info|warn|error
LOG_FORMAT=json
LOG_LEVEL=info
# The node checks the registry (halted? solvent?), the upgrade timelock and its own error rate this often. 0 = off.
WATCH_INTERVAL_MS=60000
# Upgrade timelock to watch for scheduled upgrades (CallScheduled/CallExecuted/Cancelled), and tokens whose solvency to check.
UPGRADE_TIMELOCK=0xF2d85a6C72412e6D14f527346b72c36839467faa
WATCH_TOKENS=
# Alert when at least this share of sponsored requests failed inside the window (needs at least the minimum number of requests).
WATCH_ERROR_WINDOW_MS=600000
WATCH_ERROR_MIN_REQUESTS=6
WATCH_ERROR_RATE=0.5
# Alert when a canary run (npm run canary) has not passed within this time. 0 = ignore the canary.
CANARY_MAX_AGE_MS=0

# --- Profit guard (see src/services/profit.ts) ---
# Refuse a /relay request whose gas costs more than this many times what the plan pays for it. 0 = off.
PROFIT_GUARD_MAX_MULTIPLE=0
# chainlink | fixed | off, and the feed (default: Chainlink MATIC/USD on Polygon).
PRICE_ORACLE=chainlink
# Chainlink lists this proxy as "MATIC / USD" (base asset POL, 8 decimals). It is Chainlink's contract, not part of this deployment.
NATIVE_USD_FEED=0xAB594600376Ec9fD91F8e885dADF0CE036862dE0
# Used with PRICE_ORACLE=fixed: USD per native token.
NATIVE_PRICE_USD=
ORACLE_MAX_AGE_SEC=7200
# allow = a request the guard cannot price goes through (MAX_GAS_WEI still applies); refuse = it is turned away.
PROFIT_GUARD_UNPRICED=allow
# Tokens the guard counts as 1 USD, comma-separated. Empty = USDC, USDC.e, USDT and DAI on Polygon.
# STABLE_TOKENS=


# Etherscan v2 key for the wallet's history and usage reads (GET /explorer). Server side only; the app ships no explorer key.
ETHERSCAN_API_KEY=

# Until a real channel exists, alerts can go to a local file: run `npm run alerts:sink` and set
# ALERT_WEBHOOK_URL=http://127.0.0.1:8789/alert (they are appended to data/alerts.log). Slack or Discord URLs work the same way.

# --- Not for this file ---
# These are read by single commands and belong on that command's line, never saved on the server:
#   SPONSOR_ADMIN_PRIVATE_KEY        payout wallet key, for sponsor:rotate, sponsor:withdraw, sponsor:endpoint, sponsor:relayers
#   SPONSOR_NEW_PAYOUT_PRIVATE_KEY   the new payout wallet accepting its role (sponsor:accept -- payout)
#   RELAYER_KEYSTORE_PASSWORD        keystore password; prefer RELAYER_KEYSTORE_PASSWORD_FILE above
#   SPONSOR_METADATA_HASH            only for a manual sponsor:register; sponsor:onboard works it out
